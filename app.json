{
  "expo": {
    "name": "YIIVA",
    "slug": "yiiva-app",
    "owner": "yiiva",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "yiivaapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "za.co.yiiva.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "localhost": {
              "NSExceptionAllowsInsecureHTTPLoads": true
            }
          }
        }
      }
    },
    "android": {
      "package": "za.co.yiiva.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/ICON_BLACK.png"
    },
    "assetBundlePatterns": [
      "assets/**/*"
    ],
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/ICON_WHITE.png",
          "imageWidth": 190,
          "resizeMode": "contain",
          "backgroundColor": "#3d2f26"
        }
      ],
      "expo-video",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "YIIVA needs access to your photos so you can share them in chat."
        }
      ],
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9e6accc9-c4a6-413a-8f04-e88884c77fe4"
      }
    }
  }
}
